# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser. Used by route handlers to write
# consults / subscribers with elevated rights.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cal.com — the booking link handle, e.g. "fede/consult"
NEXT_PUBLIC_CALCOM_LINK=fede/consult
