# Public, build-time Supabase config for Fede.
# These are the PUBLIC keys — safe to commit and safe to ship to the browser.
# Next.js inlines NEXT_PUBLIC_* at build time, so they must live somewhere the
# build can read them. Committing them here makes the Cloudflare Workers build
# self-sufficient (no dashboard build-variable needed).
#
# The SERVICE ROLE key is NOT here — it is a runtime-only secret set in the
# Cloudflare Worker (Settings > Variables and secrets).
NEXT_PUBLIC_SUPABASE_URL=https://srciplvjqmupwzewnpkg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_1tSqnZUVlhvANUQA300dWg_VUpuhsOg

# Cal.com booking handle (public). Powers the Book page scheduler.
NEXT_PUBLIC_CALCOM_LINK=joel-b-nvmo51/15min
